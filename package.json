{
  "name": "mon-budget-pour-la-france",
  "private": true,
  "version": "1.1.0",
  "license": "AGPL-3.0-or-later",
  "description": "Simulateur budgétaire citoyen statique : effet mécanique des leviers fiscaux et de dépense publique.",
  "homepage": "https://dedaluscode.github.io/MonBudgetPourLaFrance/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DedalusCode/MonBudgetPourLaFrance.git"
  },
  "bugs": {
    "url": "https://github.com/DedalusCode/MonBudgetPourLaFrance/issues"
  },
  "author": "Mon budget pour la France contributors",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "validate:data": "node scripts/validate-data.ts",
    "test:coverage": "vitest run --coverage",
    "docs:profiles": "node scripts/reference-profiles.ts",
    "openfisca:export": "node scripts/openfisca-check/export-cases.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "d3-hierarchy": "^3.1.3",
    "zod": "^4.6.7"
  }
}
